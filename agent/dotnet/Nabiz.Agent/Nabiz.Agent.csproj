<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Nabiz.Agent</PackageId>
    <Version>0.7.0</Version>
    <Authors>nabiz</Authors>
    <Description>
      The nabiz APM agent. Adding the package is enough: a nabiz.json is
      generated at build time and you put your server address in it. No change
      to application code is required.
    </Description>
    <PackageTags>apm;opentelemetry;tracing;observability;nabiz</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/erdemkayatr/nabiz</PackageProjectUrl>
    <RepositoryUrl>https://github.com/erdemkayatr/nabiz</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright 2026 Erdem Kaya</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeBuildOutput>true</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.18.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!--
    Everything under build/ goes into the package and loads automatically in
    the consuming project: the config template, the targets that generate the
    config, and the source file that injects automatic startup.
  -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
