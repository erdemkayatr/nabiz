<Project>

  <!--
    1) Generate the config file.

    Written only when the file is absent. Overwriting on every build would
    wipe out the server address the user entered.
  -->
  <!--
    Executable projects only. Generating a nabiz.json for a library is
    meaningless: what starts the agent and reads the configuration is the
    application itself, not an intermediate library that references it.
  -->
  <Target Name="NabizCreateConfig"
          BeforeTargets="AssignTargetPaths;BeforeBuild"
          Condition="'$(NabizGenerateConfig)' == 'true'
                     AND ('$(OutputType)' == 'Exe' OR '$(OutputType)' == 'WinExe')
                     AND !Exists('$(MSBuildProjectDirectory)/$(NabizConfigFile)')">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)nabiz.template.json"
          DestinationFiles="$(MSBuildProjectDirectory)/$(NabizConfigFile)" />
    <Message Importance="high"
             Text="nabiz: created $(NabizConfigFile). Put your server address in the 'endpoint' field." />
  </Target>

  <!--
    2) Copy the config to the output directory.

    It has to go into the ItemGroup before AssignTargetPaths; added later, it
    never makes it into the build output.
  -->
  <Target Name="NabizIncludeConfig"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="NabizCreateConfig"
          Condition="('$(OutputType)' == 'Exe' OR '$(OutputType)' == 'WinExe')
                     AND Exists('$(MSBuildProjectDirectory)/$(NabizConfigFile)')">
    <ItemGroup>
      <!-- Do not add it twice if the user already included the file. -->
      <None Include="$(MSBuildProjectDirectory)/$(NabizConfigFile)"
            Condition="'@(None)' == '' OR !$([System.String]::Copy('%(None.Identity)').EndsWith('$(NabizConfigFile)'))">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>$(NabizConfigFile)</Link>
      </None>
    </ItemGroup>
  </Target>

  <!--
    3) Inject automatic startup.

    The [ModuleInitializer] has to land in the consuming project's own
    assembly: living only inside the package, it would never run, because an
    application that touches none of the package's types never loads that
    assembly.
  -->
  <Target Name="NabizInjectAutoStart"
          BeforeTargets="BeforeCompile;CoreCompile"
          Condition="'$(NabizAutoStart)' == 'true' AND '$(Language)' == 'C#'
                     AND ('$(OutputType)' == 'Exe' OR '$(OutputType)' == 'WinExe')">
    <PropertyGroup>
      <NabizGeneratedFile>$(IntermediateOutputPath)NabizAutoStart.g.cs</NabizGeneratedFile>
    </PropertyGroup>
    <Copy SourceFiles="$(MSBuildThisFileDirectory)NabizAutoStart.cs.txt"
          DestinationFiles="$(NabizGeneratedFile)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <Compile Include="$(NabizGeneratedFile)" />
      <FileWrites Include="$(NabizGeneratedFile)" />
    </ItemGroup>
  </Target>

</Project>
