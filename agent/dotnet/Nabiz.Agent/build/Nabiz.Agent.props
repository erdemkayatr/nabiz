<Project>
  <PropertyGroup>
    <!-- The config file name. For a different name, set
         <NabizConfigFile>...</NabizConfigFile> in your project. -->
    <NabizConfigFile Condition="'$(NabizConfigFile)' == ''">nabiz.json</NabizConfigFile>

    <!-- Whether to create the file at build time when it is absent. -->
    <NabizGenerateConfig Condition="'$(NabizGenerateConfig)' == ''">true</NabizGenerateConfig>

    <!-- Automatic startup. Set it to false and you call NabizAgent.Start()
         yourself. -->
    <NabizAutoStart Condition="'$(NabizAutoStart)' == ''">true</NabizAutoStart>
  </PropertyGroup>
</Project>
