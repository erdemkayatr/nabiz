<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <!-- One line. Instrumentation, config generation and automatic startup
         all come from this package. -->
    <PackageReference Include="Nabiz.Agent" Version="0.7.0" />
    <!-- On-demand CPU and memory dumps. A separate package, so the
         diagnostics IPC stack only enters applications that need it. -->
    <PackageReference Include="Nabiz.Agent.Diagnostics" Version="0.7.0" />
  </ItemGroup>

</Project>
