<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <!-- Tek satır. Enstrümantasyon, config üretimi ve otomatik başlatma
         bu paketten geliyor. -->
    <PackageReference Include="Nabiz.Agent" Version="0.5.1" />
    <!-- Talep üzerine CPU/bellek dump'ı. Ayrı paket: tanılama IPC yığını
         yalnızca ihtiyacı olan uygulamalara girsin. -->
    <PackageReference Include="Nabiz.Agent.Diagnostics" Version="0.5.1" />
  </ItemGroup>

</Project>
