<clickhouse>
        <!-- Single-node development profile. In production, set the memory and
                  merge settings to match your hardware. -->
    <logger>
        <level>warning</level>
    </logger>
    <max_server_memory_usage_to_ram_ratio>0.7</max_server_memory_usage_to_ram_ratio>
    <merge_tree>
                <!-- Under a stream of many small inserts the part count grows fast;
                          loosening the merge thresholds eases the write path. -->
        <parts_to_delay_insert>2000</parts_to_delay_insert>
        <parts_to_throw_insert>3000</parts_to_throw_insert>
    </merge_tree>
</clickhouse>
