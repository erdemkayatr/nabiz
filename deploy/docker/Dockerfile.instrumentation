# syntax=docker/dockerfile:1

# This image runs no application: it only carries the OpenTelemetry .NET
# auto-instrumentation files. The init container the operator injects copies
# them into a shared emptyDir.
#
# Both the glibc and musl variants are inside: which one is used is decided by
# the nabiz.io/libc annotation on the pod.
ARG OTEL_AUTO_VERSION=1.16.0

FROM alpine:3.21 AS fetch
ARG OTEL_AUTO_VERSION
RUN apk add --no-cache curl unzip
WORKDIR /otel
RUN set -eux; \
    base="https://github.com/open-telemetry/opentelemetry-dotnet-instrumentation/releases/download/v${OTEL_AUTO_VERSION}"; \
    for variant in glibc musl; do \
      for arch in x64 arm64; do \
        curl -sSfL -o "/tmp/${variant}-${arch}.zip" \
          "${base}/opentelemetry-dotnet-instrumentation-linux-${variant}-${arch}.zip"; \
        unzip -q -o "/tmp/${variant}-${arch}.zip" -d /otel; \
        rm "/tmp/${variant}-${arch}.zip"; \
      done; \
    done; \
    ls -d /otel/linux-*

FROM alpine:3.21
RUN adduser -D -u 10001 nabiz
COPY --from=fetch --chown=10001:10001 /otel /otel
USER 10001
# The init container's command is supplied by the operator; this ENTRYPOINT is
# only for inspecting the image by hand.
ENTRYPOINT ["/bin/sh"]
